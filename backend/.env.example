# Ollama
OLLAMA_HOST=http://localhost:11434

# Optional:
# If omitted, the model recorded in Phase 2 config.json will be used.
# OLLAMA_MODEL=qwen2.5:7b

# Optional:
# If omitted, Phase 2 top_k_default will be used.
# TOP_K=5

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO